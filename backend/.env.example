# 이 파일을 .env로 복사해서 쓴다. .env는 Git에 올리지 않는다.

# 토큰 서명 키. 비워 두면 실행할 때마다 임시 키를 만들어, 서버를 재시작하면 앱의 접속 정보가 모두 무효가 된다.
# 통합 테스트와 배포 서버에서는 반드시 긴 임의 문자열을 넣는다.
TOKEN_SECRET=

# MVP는 SQLite. 사용자 테스트 단계에서 PostgreSQL 주소로 바꾼다.
DATABASE_URL=sqlite:///./meetroute.db

# 경로 제공자
#   estimate: 외부 전송 없는 개발용 추정치. 결과와 앱 화면에 "모의 데이터"로 표시된다.
#             경로를 직선으로 그리므로 후보 탐색 폭을 자동으로 15km로 넓힌다.
#   osrm:     실제 도로망 기준(실시간 교통 미반영). Pleos 통합 테스트는 이 값을 쓴다.
# 주의: 기본 주소는 공개 데모 서버라 좌표가 외부로 전송된다. 시뮬레이션 차량으로 시연할 때만 쓰고,
#       실제 사용자 위치를 다룰 때는 OSRM_BASE_URL을 자체 서버로 바꾸거나 국내 경로 API로 교체한다.
ROUTING_PROVIDER=estimate
OSRM_BASE_URL=https://router.project-osrm.org

# 그룹 정원(기획서 F01: MVP 3대, 최대 5대)
MAX_VEHICLES=3
